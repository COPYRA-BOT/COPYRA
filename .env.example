# =============================================================================
# COPYRA environment configuration — NAMES ONLY. Never commit real values.
# Copy to `.env` and fill in. `.env` is gitignored.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Core infrastructure
# ----------------------------------------------------------------------------
# DigitalOcean: use the PUBLIC connection string (host WITHOUT the `private-`
# prefix) unless the app runs inside the same VPC. Add the host's egress IP to
# the database's Trusted Sources.
DATABASE_URL=
# Managed Redis must use rediss:// and the PUBLIC hostname (no private-).
REDIS_URL=

API_PORT=
API_HOST=
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=
# 32+ random bytes. Generate with: openssl rand -hex 48
SESSION_SECRET=
# Public URL of the API / site. On DigitalOcean use the main domain so the
# dashboard and /api stay same-origin (SIWE cookies work):
#   PUBLIC_WEB_URL=https://copyra.fun
#   PUBLIC_API_URL=https://copyra.fun
#   PUBLIC_PLATFORM_URL=https://your-app-xxxxx.ondigitalocean.app
#   CORS_ORIGINS=https://copyra.fun,https://your-app-xxxxx.ondigitalocean.app
PUBLIC_API_URL=
PUBLIC_WEB_URL=
PUBLIC_PLATFORM_URL=

# ----------------------------------------------------------------------------
# Solana
# ----------------------------------------------------------------------------
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Optional ordered fallbacks, comma separated. Used when the primary degrades.
SOLANA_RPC_FALLBACK_URLS=
JUPITER_API_KEY=
JUPITER_API_BASE=
# Priority fee ceiling in micro-lamports per compute unit.
SOLANA_MAX_PRIORITY_FEE_MICROLAMPORTS=
SOLANA_COMPUTE_UNIT_LIMIT=

# ----------------------------------------------------------------------------
# EVM — one RPC/WS pair per chain. Leave a chain blank to disable it entirely.
# ----------------------------------------------------------------------------
EVM_ETHEREUM_RPC_URL=
EVM_ETHEREUM_WS_URL=
EVM_BASE_RPC_URL=
EVM_BASE_WS_URL=
EVM_ARBITRUM_RPC_URL=
EVM_ARBITRUM_WS_URL=
EVM_BSC_RPC_URL=
EVM_BSC_WS_URL=
EVM_POLYGON_RPC_URL=
EVM_POLYGON_WS_URL=
EVM_OPTIMISM_RPC_URL=
EVM_OPTIMISM_WS_URL=
# Monitor-only chains (no verified swap aggregator — execution is disabled).
EVM_ARC_RPC_URL=
EVM_ARC_WS_URL=
EVM_ROBINHOOD_RPC_URL=
EVM_ROBINHOOD_WS_URL=
EVM_HYPERLIQUID_RPC_URL=
EVM_HYPERLIQUID_WS_URL=
EVM_TRON_RPC_URL=

KYBERSWAP_CLIENT_ID=

# ----------------------------------------------------------------------------
# BOT SIGNING KEYS — SERVER-SIDE ONLY.
#
# * NEVER prefix these with VITE_ (that would ship them to the browser).
# * NEVER commit them. NEVER paste them into chat, a ticket or a log.
# * Use a DEDICATED wallet holding only what you are willing to lose.
# * Leave BLANK to run COPYRA in observe-only mode: it monitors, decodes,
#   qualifies, sizes and quotes for real, then records the signal as
#   BLOCKED_NO_SIGNER instead of trading. It does NOT simulate a trade.
# ----------------------------------------------------------------------------
# base58-encoded 64-byte secret key, or a JSON array of 64 integers.
SOLANA_BOT_PRIVATE_KEY=
# 0x-prefixed 32-byte hex private key.
EVM_BOT_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# Trading engine — see docs/TRADING_ENGINE.md. These are the spec defaults;
# runtime values live in the `strategy_settings` table and are editable in the UI.
# ----------------------------------------------------------------------------
# Master kill switch. `false` = no transaction is ever broadcast.
TRADING_ENABLED=
# Optional per-chain guards (default to TRADING_ENABLED when unset).
SOL_TRADING_ENABLED=
EVM_TRADING_ENABLED=
# Belt-and-braces cap enforced below the DB settings, in USD.
MAX_TRADE_USD=

# ----------------------------------------------------------------------------
# Notifications & monitoring
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ----------------------------------------------------------------------------
# Owner wallets — only these addresses may deposit / trade / withdraw
# ----------------------------------------------------------------------------
OWNER_WALLET_SOLANA=
OWNER_WALLET_EVM=

# ----------------------------------------------------------------------------
# Frontend (Vite — only VITE_* reaches the browser; keep secrets out)
# ----------------------------------------------------------------------------
VITE_API_URL=
VITE_WS_URL=
# Reown / WalletConnect Cloud project id (safe to expose). Browser reads this only.
VITE_REOWN_PROJECT_ID=
# Paid RPC keys stay on the API/worker — never put Alchemy keys in VITE_*.
